# html.snippets
snippet ta "tag"
<$1>$2</$1>
endsnippet

snippet im
<img src="/assets/$1">
endsnippet

snippet code "revealjs comment"
<pre><code data-trim data-noescape data-trim class="language-bash">
$1
</code></pre>
endsnippet

snippet cm "comment"
<!-- ${1:${VISUAL}} -->
endsnippet

snippet h2
<h2>${1:${VISUAL}}</h2>
endsnippet


