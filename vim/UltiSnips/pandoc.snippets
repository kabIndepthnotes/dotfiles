# pandoc.snippets
# this file is overwritten in the lit compile process
priority -50
extends mymathtex
priority 1

snippet pr "Preamble"
# `!v system("my_dezetelify " . expand("%:t"))`

# related

endsnippet

snippet mc "inline code" A
\`${1:${VISUAL}}\`
endsnippet

snippet cm "display code" Ab
~~~{.c .numberLines}
${1:${VISUAL}}
~~~
endsnippet

snippet tr "transclusion include file" b
~~~{.include}
${1:${VISUAL}}
~~~
endsnippet

