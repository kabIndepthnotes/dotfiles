# pandoc.snippets
priority -50
extends mymathtex
priority 1

snippet pr "Preamble"
# `!v system("/home/kab/docs/my_scripts/my_dezetelify " . expand("%:t"))`

# related

endsnippet

snippet mc "inline code" A
\`${1:${VISUAL}}\`
endsnippet

snippet cm "display code" Ab
~~~{.c .numberLines}
${1:${VISUAL}}
~~~
endsnippet

snippet gm "display code" Ab
~~~{.gd .numberLines}
${1:${VISUAL}}
~~~
endsnippet
